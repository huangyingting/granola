{
  "appId": "io.github.windowsainotes.desktop",
  "productName": "Windows AI Notes Preview",
  "artifactName": "windows-ai-notes-${version}-${arch}-unsigned.${ext}",
  "directories": { "output": "../../artifacts/desktop" },
  "files": [
    "dist/main/**/*.js",
    "!dist/main/**/*.test.js",
    "dist/preload.cjs",
    "dist/renderer/**/*",
    "package.json"
  ],
  "asar": true,
  "extraResources": [
    { "from": "dist/THIRD_PARTY_NOTICES.txt", "to": "THIRD_PARTY_NOTICES.txt" },
    {
      "from": "../../artifacts/audio-host/win-x64",
      "to": "audio-host",
      "filter": ["**/*", "!**/*.pdb"]
    }
  ],
  "forceCodeSigning": false,
  "npmRebuild": false,
  "win": { "target": ["nsis"] },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}
