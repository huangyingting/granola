{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src/renderer",
    "outDir": "dist/types",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "emitDeclarationOnly": true
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx"],
  "references": [{ "path": "../../packages/contracts" }]
}
