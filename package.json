{
  "name": "windows-ai-notes",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audio:probe": "node tools/audio-probe/dist/index.js",
    "test:native": "dotnet test native/audio-host/AudioHost.Tests/AudioHost.Tests.csproj --configuration Release",
    "build:native": "dotnet build native/audio-host/AudioHost/AudioHost.csproj --configuration Release",
    "audio:publish": "dotnet restore native/audio-host/AudioHost/AudioHost.csproj --locked-mode && dotnet publish native/audio-host/AudioHost/AudioHost.csproj --configuration Release --runtime win-x64 --self-contained true --no-restore --output artifacts/audio-host/win-x64",
    "api": "node --env-file-if-exists=.env apps/api/dist/main.js",
    "worker": "node --env-file-if-exists=.env apps/worker/dist/main.js",
    "db:migrate": "node --env-file-if-exists=.env packages/db/dist/cli.js migrate",
    "user:provision": "node --env-file-if-exists=.env packages/db/dist/cli.js provision",
    "usage:limits": "node --env-file-if-exists=.env packages/db/dist/cli.js usage-limits",
    "audio:retention": "node --env-file-if-exists=.env packages/db/dist/cli.js audio-retention",
    "operations": "node --env-file-if-exists=.env packages/db/dist/cli.js operations",
    "audit:events": "node --env-file-if-exists=.env packages/db/dist/cli.js audit",
    "deletion:init": "node --env-file-if-exists=.env packages/db/dist/cli.js deletion-init",
    "deletion:recover": "node --env-file-if-exists=.env packages/db/dist/cli.js deletion-recover",
    "deletion:usage-reviewed": "node --env-file-if-exists=.env packages/db/dist/cli.js deletion-usage-reviewed",
    "azure:probe": "node tools/azure-probe/dist/index.js",
    "azure:live-probe": "node tools/azure-probe/dist/live.js",
    "test:server": "vitest run apps/api/src/server.test.ts",
    "desktop:build": "pnpm --filter @windows-ai-notes/desktop build",
    "desktop": "pnpm desktop:build && pnpm --filter @windows-ai-notes/desktop start",
    "desktop:test": "pnpm --filter @windows-ai-notes/desktop test:ui",
    "desktop:package:unsigned": "pnpm desktop:build && pnpm --filter @windows-ai-notes/desktop package:unsigned"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
