# Local development only. Copy to .env; never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=4411
AUTH_MODE=development
DATABASE_URL=postgresql://notes:local-development-only@127.0.0.1:55432/notes
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=55432

# Optional private raw-audio storage. The desktop upload UI is not connected yet.
# Provision a PRIVATE, UNVERSIONED S3-compatible bucket before starting the API.
# S3_ENDPOINT=http://127.0.0.1:59000
# S3_BUCKET=notes-recordings
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=local-storage-only
# S3_SECRET_ACCESS_KEY=local-storage-secret-only
# S3_ENCRYPTION=none
# Production requires HTTPS and S3_ENCRYPTION=AES256 or aws:kms.
# S3_KMS_KEY_ID=YOUR-KMS-KEY-ID
# Omit both S3 credential variables to use the server's AWS workload identity.

# Optional: import ONLY the six Azure OpenAI/Speech variables from this file.
# Existing process environment variables take precedence.
AZURE_ENV_FILE=../ReadWise/.env

# Alternatively set these directly instead of AZURE_ENV_FILE:
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# Optional authenticated live Speech gateway; disabled by default.
# The API imports only Speech key/region when enabled, not OpenAI credentials.
# Desktop live-cloud consent/orchestration is not connected yet.
# LIVE_SPEECH_ENABLED=true

# Production must use OIDC and its own API registration, not development headers.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://YOUR-ISSUER/
# OIDC_AUDIENCE=YOUR-API-AUDIENCE
# OIDC_JWKS_URL=https://YOUR-ISSUER/.well-known/jwks.json
# OIDC_REQUIRED_SCOPE=notes.access
# Optional desktop public-client registration; no client secret.
# Register http://127.0.0.1/oauth/callback with dynamic loopback ports.
# OIDC_DESKTOP_CLIENT_ID=YOUR-NATIVE-PUBLIC-CLIENT-ID
# OIDC_DESKTOP_SCOPES=openid profile offline_access api://YOUR-API-AUDIENCE/notes.access
# Use localhost instead if that is the loopback hostname registered with the issuer.
# OIDC_DESKTOP_LOOPBACK_HOST=127.0.0.1
