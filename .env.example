# Local development only. Copy to .env; never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=4411
AUTH_MODE=development
DATABASE_URL=postgresql://notes:local-development-only@127.0.0.1:55432/notes
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=55432

# Optional: import ONLY the six Azure OpenAI/Speech variables from this file.
# Existing process environment variables take precedence.
AZURE_ENV_FILE=../ReadWise/.env

# Alternatively set these directly instead of AZURE_ENV_FILE:
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# Production must use OIDC and its own API registration, not development headers.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://YOUR-ISSUER/
# OIDC_AUDIENCE=YOUR-API-AUDIENCE
# OIDC_JWKS_URL=https://YOUR-ISSUER/.well-known/jwks.json
# OIDC_REQUIRED_SCOPE=notes.access
